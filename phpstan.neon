includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 8

    # Framework docblocks are often more optimistic than the code they describe
    # (Seeder::$command is documented non-nullable but is an untyped property
    # defaulting to null). Without this, guarding against reality is reported
    # as a redundant check.
    treatPhpDocTypesAsCertain: false
